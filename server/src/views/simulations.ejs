<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
    <style>
        .demo-banner {
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.15), rgba(99, 102, 241, 0.15));
            border: 1px solid rgba(56, 189, 248, 0.3);
            border-radius: 12px;
            padding: 1rem 1.5rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .demo-badge-group {
            display: flex;
            gap: 0.5rem;
        }

        .tab-nav {
            display: flex;
            gap: 0.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 1.5rem;
            overflow-x: auto;
            padding-bottom: 0.5rem;
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: #94a3b8;
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .tab-btn:hover {
            color: #f8fafc;
            background: rgba(255, 255, 255, 0.05);
        }

        .tab-btn.active {
            color: #38bdf8;
            background: rgba(56, 189, 248, 0.15);
            border: 1px solid rgba(56, 189, 248, 0.3);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .mock-window {
            background: #0f172a;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
        }

        .mock-window-header {
            background: #1e293b;
            padding: 0.6rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .mock-window-controls {
            display: flex;
            gap: 0.4rem;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .dot-red { background: #ef4444; }
        .dot-yellow { background: #eab308; }
        .dot-green { background: #22c55e; }

        .mock-window-body {
            padding: 1.5rem;
        }

        .bsod-preview {
            background: #0078d7;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 3rem 2rem;
            border-radius: 8px;
            text-align: center;
            box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.2);
        }

        .bsod-title {
            font-size: 2.2rem;
            font-weight: 300;
            margin-bottom: 1rem;
        }

        .bsod-subtitle {
            font-size: 1.3rem;
            font-weight: 400;
            opacity: 0.9;
        }

        .spinner-sim {
            margin: 2rem auto;
            width: 40px;
            height: 40px;
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: #ffffff;
            animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .file-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .file-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            transition: background 0.2s;
        }

        .file-item:hover {
            background: rgba(255, 255, 255, 0.03);
        }

        .file-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
    </style>
</head>

<body>
    <div class="layout">
        <%- include('partials/sidebar') %>

        <main class="main-content">
            <%- include('partials/header-bar') %>

            <div class="page-content">

                <!-- Demonstration Banner -->
                <div class="demo-banner">
                    <div>
                        <h2 style="margin: 0 0 0.25rem 0; font-size: 1.25rem; color: #f8fafc;">
                            <i class="fas fa-flask text-primary"></i>
                            Cybersecurity Educational Laboratory
                        </h2>
                        <p style="margin: 0; font-size: 0.875rem; color: #94a3b8;">
                            Controlled non-functional demonstrations for cybersecurity instruction and risk awareness.
                        </p>
                    </div>
                    <div class="demo-badge-group">
                        <span class="badge badge-warning">
                            <i class="fas fa-microchip"></i> Educational Simulation
                        </span>
                        <span class="badge badge-primary">
                            <i class="fas fa-code-branch"></i> Under Development
                        </span>
                    </div>
                </div>

                <!-- Target & Background Config Bar -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-crosshairs text-danger"></i>
                            Target Selection & Background Interval Settings
                        </h3>
                    </div>
                    <div class="grid-2">
                        <div>
                            <label class="form-label">Active Target Endpoint</label>
                            <select id="targetSelect" class="form-control" onchange="changeTarget(this.value)">
                                <% simulation.targets.forEach(function(t) { %>
                                    <option value="<%= t.id %>" <%= simulation.selectedTarget === t.id ? 'selected' : '' %>>
                                        <%= t.username %> (<%= t.ip %> - <%= t.os %>)
                                    </option>
                                <% }); %>
                            </select>
                            <small class="text-muted mt-1 d-block">
                                Selected target will receive educational simulation triggers.
                            </small>
                        </div>

                        <div>
                            <label class="form-label">Simulation Loop Interval (Seconds)</label>
                            <div style="display: flex; gap: 0.5rem;">
                                <input type="number" id="intervalInput" class="form-control" value="<%= simulation.intervalSeconds %>" min="5" max="300">
                                <button class="btn btn-primary" onclick="updateConfig()">
                                    <i class="fas fa-save"></i> Save
                                </button>
                            </div>
                            <small class="text-muted mt-1 d-block">
                                Controls periodic polling interval when running as background simulation.
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Tab Navigation -->
                <div class="tab-nav">
                    <button class="tab-btn active" onclick="switchTab('screen-tab')">
                        <i class="fas fa-desktop"></i> Screen Overlay
                    </button>
                    <button class="tab-btn" onclick="switchTab('backdoor-tab')">
                        <i class="fas fa-terminal"></i> Backdoor Simulation
                    </button>
                    <button class="tab-btn" onclick="switchTab('filemanager-tab')">
                        <i class="fas fa-folder-open"></i> Mock File Manager
                    </button>
                    <button class="tab-btn" onclick="switchTab('datatransfer-tab')">
                        <i class="fas fa-exchange-alt"></i> Data Transfer
                    </button>
                    <button class="tab-btn" onclick="switchTab('remote-tab')">
                        <i class="fas fa-headset"></i> Remote Operation (AnyDesk)
                    </button>
                    <button class="tab-btn" onclick="switchTab('webcam-tab')">
                        <i class="fas fa-video"></i> Mock Webcam
                    </button>
                </div>

                <!-- TAB 1: Screen Overlay Simulation -->
                <div id="screen-tab" class="tab-content active">
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title">
                                    <i class="fas fa-window-maximize text-info"></i>
                                    Windows Light-Blue Screen Overlay Simulation
                                </h3>
                                <p class="text-muted mb-0">Simulates non-disruptive Windows maintenance display ("Removing virus" / "Please wait.")</p>
                            </div>
                            <button class="btn btn-primary" onclick="triggerScreenOverlay()">
                                <i class="fas fa-play"></i> Trigger Demonstration
                            </button>
                        </div>

                        <div class="bsod-preview my-3">
                            <div class="bsod-title">Removing virus</div>
                            <div class="bsod-subtitle">Please wait.</div>
                            <div class="spinner-sim"></div>
                            <div style="font-size: 0.85rem; opacity: 0.75; margin-top: 1.5rem;">
                                [ Educational Simulation Display - Non-Destructive ]
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: Educational Backdoor Simulation -->
                <div id="backdoor-tab" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-network-wired text-warning"></i>
                                Educational Backdoor Session Monitor
                            </h3>
                            <span class="badge badge-success">
                                <i class="fas fa-shield-alt"></i> Sandboxed Environment
                            </span>
                        </div>

                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Timestamp</th>
                                        <th>Target Endpoint</th>
                                        <th>Action / Event</th>
                                        <th>Status</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% simulation.simulationLogs.forEach(function(log) { %>
                                        <tr>
                                            <td><code class="code-tag secondary"><%= new Date(log.timestamp).toLocaleTimeString() %></code></td>
                                            <td><strong><%= log.target %></strong></td>
                                            <td><%= log.action %></td>
                                            <td>
                                                <span class="badge badge-primary"><%= log.status %></span>
                                            </td>
                                            <td><small class="text-muted"><%= log.info %></small></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- TAB 3: Mock File Manager Interface -->
                <div id="filemanager-tab" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-folder-tree text-secondary"></i>
                                Mock File Manager Interface (Risk Demonstration)
                            </h3>
                            <span class="badge badge-warning">Non-Functional Interface (Dummy Data)</span>
                        </div>

                        <ul class="file-list">
                            <% simulation.mockFiles.forEach(function(file) { %>
                                <li class="file-item">
                                    <div class="file-info">
                                        <i class="fas fa-file-alt text-primary" style="font-size: 1.25rem;"></i>
                                        <div>
                                            <div style="font-weight: 600;"><%= file.name %></div>
                                            <small class="text-muted"><%= file.path %> &bull; <%= file.size %></small>
                                        </div>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 1rem;">
                                        <span class="badge badge-danger"><%= file.riskLevel %></span>
                                        <button class="btn btn-sm btn-secondary" onclick="simulateExfiltration('<%= file.id %>')">
                                            <i class="fas fa-download"></i> Simulate Access
                                        </button>
                                    </div>
                                </li>
                            <% }); %>
                        </ul>
                    </div>
                </div>

                <!-- TAB 4: Simulated Data Transfer Module -->
                <div id="datatransfer-tab" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-file-export text-danger"></i>
                                Data Transfer Visualization Module
                            </h3>
                            <span class="badge badge-primary">Sample / Dummy Data Only</span>
                        </div>

                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Simulated File</th>
                                        <th>Size</th>
                                        <th>Transfer Rate</th>
                                        <th>Progress</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% simulation.dataTransfers.forEach(function(dt) { %>
                                        <tr>
                                            <td><strong><%= dt.filename %></strong></td>
                                            <td><%= dt.size %></td>
                                            <td><code><%= dt.speed %></code></td>
                                            <td style="width: 25%;">
                                                <div style="background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden; height: 10px;">
                                                    <div style="background: #22c55e; width: <%= dt.progress %>%; height: 100%;"></div>
                                                </div>
                                            </td>
                                            <td><span class="badge badge-success"><%= dt.status %></span></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- TAB 5: Mock Remote Operation Interface -->
                <div id="remote-tab" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-desktop text-success"></i>
                                Mock Remote Operation Interface (AnyDesk Demonstration Style)
                            </h3>
                            <span class="badge badge-warning">Non-Functional UI Only</span>
                        </div>

                        <div class="mock-window">
                            <div class="mock-window-header">
                                <div class="mock-window-controls">
                                    <div class="dot dot-red"></div>
                                    <div class="dot dot-yellow"></div>
                                    <div class="dot dot-green"></div>
                                </div>
                                <div style="font-size: 0.85rem; color: #94a3b8;">AnyDesk Remote Desk Simulation - Session #984 210 339</div>
                                <div></div>
                            </div>
                            <div class="mock-window-body text-center" style="padding: 3rem 1rem;">
                                <i class="fas fa-laptop-code" style="font-size: 4rem; color: #38bdf8; margin-bottom: 1rem;"></i>
                                <h4>Remote Operation View (Educational Preview)</h4>
                                <p class="text-muted max-w-md mx-auto mb-3">
                                    This mock screen illustrates how unauthorized remote assistance tools present telemetry during remote operations.
                                </p>
                                <span class="badge badge-primary">Connected to Workstation-Corp-01 (Simulated)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 6: Mock Webcam Module -->
                <div id="webcam-tab" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-camera text-info"></i>
                                Mock Webcam Peripheral Access Demonstration
                            </h3>
                            <button class="btn btn-primary" onclick="triggerWebcamSim()">
                                <i class="fas fa-camera-retro"></i> Capture Simulated Frame
                            </button>
                        </div>

                        <div class="text-center my-3">
                            <p class="text-muted mb-3">Uses strictly synthetic sample imagery. No physical camera device accessed.</p>
                            <div id="webcamFeed">
                                <% if (simulation.mockWebcamCaptures.length > 0) { %>
                                    <img src="<%= simulation.mockWebcamCaptures[0].svgDataUri %>" alt="Webcam Simulation" style="max-width: 100%; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <%- include('partials/scripts') %>

    <script>
        function switchTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

            event.currentTarget.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }

        async function changeTarget(targetId) {
            await fetch('/api/simulation/target', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ targetId })
            });
            location.reload();
        }

        async function updateConfig() {
            const intervalSeconds = document.getElementById('intervalInput').value;
            const res = await fetch('/api/simulation/config', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ intervalSeconds, backgroundModeEnabled: true })
            });
            if (res.ok) alert('Simulation settings updated.');
        }

        async function triggerScreenOverlay() {
            const targetId = document.getElementById('targetSelect').value;
            const res = await fetch('/api/simulation/trigger-screen', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ targetId, durationSeconds: 5 })
            });
            if (res.ok) alert('Screen overlay demonstration command issued!');
        }

        async function simulateExfiltration(fileId) {
            const targetId = document.getElementById('targetSelect').value;
            const res = await fetch('/api/simulation/trigger-transfer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ fileId, targetId })
            });
            if (res.ok) location.reload();
        }

        async function triggerWebcamSim() {
            const targetId = document.getElementById('targetSelect').value;
            const res = await fetch('/api/simulation/trigger-webcam', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ targetId })
            });
            if (res.ok) location.reload();
        }
    </script>
</body>

</html>
