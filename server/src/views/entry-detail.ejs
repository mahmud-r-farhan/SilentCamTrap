<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
    <% if (entry.extraData?.location?.latitude) { %>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
    <% } %>
</head>

<body>
    <div class="layout">
        <%- include('partials/sidebar') %>

        <main class="main-content">
            <%- include('partials/header-bar') %>

            <div class="page-content">
                <div class="mb-4">
                    <a href="/entries" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left"></i>
                        Back to Entries
                    </a>
                </div>

                <div class="grid-2">
                    <!-- Image Card -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-camera text-primary"></i>
                                Captured Image
                            </h3>
                            <span class="badge badge-primary">
                                <i class="fas fa-clock"></i>
                                <%= new Date(entry.timestamp).toLocaleString() %>
                            </span>
                        </div>

                        <div class="capture-image-wrap">
                            <img src="/uploads/<%= entry.imagePath %>" alt="Intruder Capture" id="capture-img" class="capture-img" onerror="this.style.display='none'; document.getElementById('img-fallback').style.display='flex'">
                            <div id="img-fallback" class="img-fallback">
                                <i class="fas fa-camera-slash"></i>
                                <span>Image not available</span>
                            </div>
                        </div>

                        <div class="card-actions-row">
                            <a href="/uploads/<%= entry.imagePath %>" download class="btn btn-primary btn-sm flex-1">
                                <i class="fas fa-download"></i>
                                Download Image
                            </a>
                            <button class="btn btn-danger btn-sm" onclick="deleteEntry('<%= entry.id %>')">
                                <i class="fas fa-trash"></i>
                                Delete
                            </button>
                        </div>
                    </div>

                    <!-- Details Card -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-info-circle text-secondary"></i>
                                Capture Details
                            </h3>
                        </div>

                        <!-- Network Information -->
                        <div class="detail-section">
                            <h4 class="detail-section-title">
                                <i class="fas fa-network-wired"></i>
                                Network Information
                            </h4>
                            <div class="info-list">
                                <div class="info-row">
                                    <span class="info-label">Public IP</span>
                                    <code class="code-tag primary"><%= entry.extraData?.network?.public_ip || 'N/A' %></code>
                                </div>
                                <div class="info-row">
                                    <span class="info-label">Local IP</span>
                                    <code class="code-tag secondary"><%= entry.extraData?.network?.local_ip || 'N/A' %></code>
                                </div>
                                <div class="info-row">
                                    <span class="info-label">Hostname</span>
                                    <span class="font-medium"><%= entry.extraData?.network?.hostname || 'N/A' %></span>
                                </div>
                            </div>
                        </div>

                        <!-- Location Information -->
                        <div class="detail-section">
                            <h4 class="detail-section-title">
                                <i class="fas fa-map-marker-alt"></i>
                                Location Information
                            </h4>
                            <% if (entry.extraData?.location?.latitude) { %>
                                <div class="info-list">
                                    <div class="info-row">
                                        <span class="info-label">City</span>
                                        <span class="font-medium"><%= entry.extraData.location.city || 'Unknown' %></span>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Country</span>
                                        <span class="font-medium"><%= entry.extraData.location.country || 'Unknown' %></span>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Coordinates</span>
                                        <code class="code-tag success">
                                            <%= entry.extraData.location.latitude?.toFixed(4) %>, <%= entry.extraData.location.longitude?.toFixed(4) %>
                                        </code>
                                    </div>
                                </div>

                                <div id="detail-map" class="detail-map-container"></div>
                            <% } else { %>
                                <div class="no-data-box">Location data not available</div>
                            <% } %>
                        </div>

                        <!-- System Information -->
                        <% if (entry.extraData?.system?.os_name) { %>
                            <div class="detail-section">
                                <h4 class="detail-section-title">
                                    <i class="fas fa-desktop"></i>
                                    System Information
                                </h4>
                                <div class="info-list">
                                    <div class="info-row">
                                        <span class="info-label">Operating System</span>
                                        <span class="badge badge-primary">
                                            <i class="<%= entry.extraData.system.os_name === 'Windows' ? 'fab fa-windows' : entry.extraData.system.os_name === 'Darwin' ? 'fab fa-apple' : 'fab fa-linux' %>"></i>
                                            <%= entry.extraData.system.os_name %> <%= entry.extraData.system.os_release || '' %>
                                        </span>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Username</span>
                                        <code class="code-tag warning"><%= entry.extraData.system.username || 'N/A' %></code>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Machine</span>
                                        <span class="font-medium"><%= entry.extraData.system.machine || 'N/A' %></span>
                                    </div>
                                    <% if (entry.extraData.system.screen_width) { %>
                                        <div class="info-row">
                                            <span class="info-label">Screen Resolution</span>
                                            <code class="code-tag primary"><%= entry.extraData.system.screen_width %> &times; <%= entry.extraData.system.screen_height %></code>
                                        </div>
                                    <% } %>
                                    <% if (entry.extraData.system.battery_percent !== null && entry.extraData.system.battery_percent !== undefined) { %>
                                        <div class="info-row">
                                            <span class="info-label">Battery</span>
                                            <span class="font-medium">
                                                <%= entry.extraData.system.battery_percent %>%
                                                <% if (entry.extraData.system.battery_plugged) { %>
                                                    <i class="fas fa-plug text-success ml-1"></i>
                                                <% } %>
                                            </span>
                                        </div>
                                    <% } %>
                                    <% if (entry.extraData.network?.wifi_ssid) { %>
                                        <div class="info-row">
                                            <span class="info-label">Wi-Fi SSID</span>
                                            <code class="code-tag secondary"><%= entry.extraData.network.wifi_ssid %></code>
                                        </div>
                                    <% } %>
                                    <div class="info-row">
                                        <span class="info-label">Python Version</span>
                                        <code class="code-tag warning"><%= entry.extraData.system.python_version || 'N/A' %></code>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Browser History Card -->
                <% if (entry.extraData?.browser_histories) { %>
                    <div class="card mt-4">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-history text-warning"></i>
                                Browser History
                            </h3>
                        </div>

                        <div class="browser-history-grid">
                            <!-- Chrome -->
                            <div class="browser-column">
                                <h4 class="browser-title">
                                    <i class="fab fa-chrome chrome-icon"></i> Chrome
                                </h4>
                                <% if (Array.isArray(entry.extraData.browser_histories.chrome) && entry.extraData.browser_histories.chrome.length > 0) { %>
                                    <div class="history-list">
                                        <% entry.extraData.browser_histories.chrome.forEach(function(item) { %>
                                            <div class="history-item">
                                                <div class="history-item-title"><%= item.title || 'No Title' %></div>
                                                <div class="history-item-url"><%= item.url %></div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <div class="no-data-box">
                                        <%= entry.extraData.browser_histories.chrome?.error || entry.extraData.browser_histories.chrome?.info || 'No history available' %>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Firefox -->
                            <div class="browser-column">
                                <h4 class="browser-title">
                                    <i class="fab fa-firefox-browser firefox-icon"></i> Firefox
                                </h4>
                                <% if (Array.isArray(entry.extraData.browser_histories.firefox) && entry.extraData.browser_histories.firefox.length > 0) { %>
                                    <div class="history-list">
                                        <% entry.extraData.browser_histories.firefox.forEach(function(item) { %>
                                            <div class="history-item">
                                                <div class="history-item-title"><%= item.title || 'No Title' %></div>
                                                <div class="history-item-url"><%= item.url %></div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <div class="no-data-box">
                                        <%= entry.extraData.browser_histories.firefox?.error || entry.extraData.browser_histories.firefox?.info || 'No history available' %>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Edge -->
                            <% if (entry.extraData.browser_histories.edge) { %>
                                <div class="browser-column">
                                    <h4 class="browser-title">
                                        <i class="fab fa-edge edge-icon"></i> Edge
                                    </h4>
                                    <% if (Array.isArray(entry.extraData.browser_histories.edge) && entry.extraData.browser_histories.edge.length > 0) { %>
                                        <div class="history-list">
                                            <% entry.extraData.browser_histories.edge.forEach(function(item) { %>
                                                <div class="history-item">
                                                    <div class="history-item-title"><%= item.title || 'No Title' %></div>
                                                    <div class="history-item-url"><%= item.url %></div>
                                                </div>
                                            <% }); %>
                                        </div>
                                    <% } else { %>
                                        <div class="no-data-box">
                                            <%= entry.extraData.browser_histories.edge?.error || entry.extraData.browser_histories.edge?.info || 'No Edge history available' %>
                                        </div>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>

                <!-- Raw JSON Data Card -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-code text-success"></i>
                            Raw Data
                        </h3>
                        <button class="btn btn-secondary btn-sm" onclick="copyRawData()">
                            <i class="fas fa-copy"></i>
                            Copy JSON
                        </button>
                    </div>
                    <pre id="raw-data" class="json-viewer"><%= JSON.stringify(entry, null, 2) %></pre>
                </div>
            </div>
        </main>
    </div>

    <% if (entry.extraData?.location?.latitude) { %>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <% } %>
    <%- include('partials/scripts') %>

    <script>
        <% if (entry.extraData?.location?.latitude) { %>
            const lat = <%= entry.extraData.location.latitude %>;
            const lng = <%= entry.extraData.location.longitude %>;

            const map = L.map('detail-map').setView([lat, lng], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            const markerIcon = L.divIcon({
                html: '<div class="map-detail-marker"></div>',
                className: 'custom-marker',
                iconSize: [16, 16],
                iconAnchor: [8, 8],
                popupAnchor: [0, -10]
            });

            L.marker([lat, lng], { icon: markerIcon })
                .addTo(map)
                .bindPopup('<b><%= entry.extraData.location.city || "Unknown" %>, <%= entry.extraData.location.country || "" %></b>')
                .openPopup();
        <% } %>

        function copyRawData() {
            const data = document.getElementById('raw-data').textContent;
            navigator.clipboard.writeText(data).then(() => {
                showToast('JSON copied to clipboard', 'success');
            }).catch(() => {
                const ta = document.createElement('textarea');
                ta.value = data;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                ta.remove();
                showToast('JSON copied to clipboard', 'success');
            });
        }
    </script>
</body>

</html>
