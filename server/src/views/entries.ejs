<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/static/css/entries.css">
</head>

<body>
    <div class="layout">
        <%- include('partials/sidebar') %>

        <main class="main-content">
            <%- include('partials/header-bar') %>

            <div class="page-content">
                <!-- Page Action Bar -->
                <div class="entries-action-bar">
                    <div>
                        <p class="entries-subtitle">Showing <%= total %> total captures</p>
                    </div>
                    <div class="entries-btn-group">
                        <a href="/api/export/csv" class="btn btn-secondary btn-sm">
                            <i class="fas fa-file-csv"></i>
                            Export CSV
                        </a>
                        <a href="/api/export/json" class="btn btn-secondary btn-sm">
                            <i class="fas fa-file-code"></i>
                            Export JSON
                        </a>
                    </div>
                </div>

                <!-- Entries Table Card -->
                <div class="card">
                    <% if (entries.length > 0) { %>
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Image</th>
                                        <th>Captured At</th>
                                        <th>Location</th>
                                        <th>Public IP</th>
                                        <th>Local IP</th>
                                        <th>Username</th>
                                        <th>System</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% entries.forEach(function(entry) { %>
                                        <tr>
                                            <td>
                                                <a href="/entry/<%= entry.id %>" class="thumbnail-link">
                                                    <img src="/uploads/<%= entry.imagePath %>" alt="Capture" class="thumbnail" onerror="this.onerror=null; this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2250%22 height=%2250%22><rect fill=%22%23334155%22 width=%22100%%22 height=%22100%%22/><text fill=%22%2364748b%22 x=%2225%22 y=%2230%22 text-anchor=%22middle%22 font-size=%2210%22>N/A</text></svg>'">
                                                </a>
                                            </td>
                                            <td>
                                                <div class="font-medium">
                                                    <%= new Date(entry.timestamp).toLocaleDateString() %>
                                                </div>
                                                <div class="text-xs text-muted">
                                                    <%= new Date(entry.timestamp).toLocaleTimeString() %>
                                                </div>
                                            </td>
                                            <td>
                                                <% if (entry.extraData?.location?.city) { %>
                                                    <div class="location-cell">
                                                        <i class="fas fa-map-marker-alt text-primary"></i>
                                                        <div>
                                                            <div class="font-medium"><%= entry.extraData.location.city %></div>
                                                            <div class="text-xs text-muted"><%= entry.extraData.location.country %></div>
                                                        </div>
                                                    </div>
                                                <% } else { %>
                                                    <span class="badge badge-warning">
                                                        <i class="fas fa-question-circle"></i>
                                                        Unknown
                                                    </span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <code class="code-tag secondary">
                                                    <%= entry.extraData?.network?.public_ip || 'N/A' %>
                                                </code>
                                            </td>
                                            <td>
                                                <code class="code-tag muted">
                                                    <%= entry.extraData?.network?.local_ip || 'N/A' %>
                                                </code>
                                            </td>
                                            <td>
                                                <% if (entry.extraData?.system?.username) { %>
                                                    <code class="code-tag warning">
                                                        <%= entry.extraData.system.username %>
                                                    </code>
                                                <% } else { %>
                                                    <span class="text-muted">-</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (entry.extraData?.system?.os_name) { %>
                                                    <span class="badge badge-primary">
                                                        <i class="<%= entry.extraData.system.os_name === 'Windows' ? 'fab fa-windows' : entry.extraData.system.os_name === 'Darwin' ? 'fab fa-apple' : 'fab fa-linux' %>"></i>
                                                        <%= entry.extraData.system.os_name %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="text-muted">-</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <a href="/entry/<%= entry.id %>" class="btn btn-icon btn-secondary" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <button class="btn btn-icon btn-danger" onclick="deleteEntry('<%= entry.id %>')" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <% if (totalPages > 1) { %>
                            <div class="pagination-container">
                                <% if (page > 1) { %>
                                    <a href="/entries?page=<%= page - 1 %>" class="btn btn-secondary btn-sm">
                                        <i class="fas fa-chevron-left"></i>
                                        Previous
                                    </a>
                                <% } %>

                                <div class="pagination-pages">
                                    <% let startPage = Math.max(1, page - 2); let endPage = Math.min(totalPages, page + 2); %>

                                    <% if (startPage > 1) { %>
                                        <a href="/entries?page=1" class="btn btn-secondary btn-sm page-btn">1</a>
                                        <% if (startPage > 2) { %>
                                            <span class="pagination-dots">...</span>
                                        <% } %>
                                    <% } %>

                                    <% for (let i = startPage; i <= endPage; i++) { %>
                                        <a href="/entries?page=<%= i %>" class="btn <%= i === page ? 'btn-primary' : 'btn-secondary' %> btn-sm page-btn">
                                            <%= i %>
                                        </a>
                                    <% } %>

                                    <% if (endPage < totalPages) { %>
                                        <% if (endPage < totalPages - 1) { %>
                                            <span class="pagination-dots">...</span>
                                        <% } %>
                                        <a href="/entries?page=<%= totalPages %>" class="btn btn-secondary btn-sm page-btn">
                                            <%= totalPages %>
                                        </a>
                                    <% } %>
                                </div>

                                <% if (page < totalPages) { %>
                                    <a href="/entries?page=<%= page + 1 %>" class="btn btn-secondary btn-sm">
                                        Next
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                <% } %>
                            </div>
                        <% } %>

                    <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-camera-retro"></i>
                            <h3>No Captures Found</h3>
                            <p>Waiting for the first intruder detection...</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <%- include('partials/scripts') %>
</body>

</html>
