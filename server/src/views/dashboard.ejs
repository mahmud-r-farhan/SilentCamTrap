<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
</head>

<body>
    <div class="layout">
        <%- include('partials/sidebar') %>

        <main class="main-content">
            <%- include('partials/header-bar') %>

            <div class="page-content">
                <!-- Stats Grid -->
                <div class="stats-grid">
                    <div class="card stat-card primary">
                        <div class="card-header">
                            <div>
                                <div class="stat-value"><%= stats.total %></div>
                                <div class="stat-label">Total Captures</div>
                            </div>
                            <div class="card-icon">
                                <i class="fas fa-camera"></i>
                            </div>
                        </div>
                        <i class="fas fa-database stat-bg-icon"></i>
                    </div>

                    <div class="card stat-card success">
                        <div class="card-header">
                            <div>
                                <div class="stat-value"><%= stats.today %></div>
                                <div class="stat-label">Today's Captures</div>
                                <% if (stats.today > 0) { %>
                                    <span class="stat-change positive">
                                        <i class="fas fa-arrow-up"></i>
                                        Active
                                    </span>
                                <% } %>
                            </div>
                            <div class="card-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                        </div>
                        <i class="fas fa-bolt stat-bg-icon"></i>
                    </div>

                    <div class="card stat-card warning">
                        <div class="card-header">
                            <div>
                                <div class="stat-value"><%= stats.thisWeek %></div>
                                <div class="stat-label">This Week</div>
                            </div>
                            <div class="card-icon">
                                <i class="fas fa-calendar-week"></i>
                            </div>
                        </div>
                        <i class="fas fa-chart-line stat-bg-icon"></i>
                    </div>

                    <div class="card stat-card danger">
                        <div class="card-header">
                            <div>
                                <div class="stat-value"><%= stats.countries.length %></div>
                                <div class="stat-label">Countries Detected</div>
                            </div>
                            <div class="card-icon">
                                <i class="fas fa-globe"></i>
                            </div>
                        </div>
                        <i class="fas fa-map-marker-alt stat-bg-icon"></i>
                    </div>
                </div>

                <div class="grid-2">
                    <!-- Recent Captures -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-history text-primary"></i>
                                Recent Captures
                            </h3>
                            <a href="/entries" class="btn btn-sm btn-secondary">View All</a>
                        </div>

                        <% if (recentEntries.length > 0) { %>
                            <div class="table-container">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Image</th>
                                            <th>Time</th>
                                            <th>Location</th>
                                            <th>IP</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% recentEntries.slice(0, 5).forEach(function(entry) { %>
                                            <tr>
                                                <td>
                                                    <a href="/entry/<%= entry.id %>">
                                                        <img src="/uploads/<%= entry.imagePath %>" alt="Capture" class="thumbnail" onerror="this.onerror=null; this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2250%22 height=%2250%22><rect fill=%22%23334155%22 width=%22100%%22 height=%22100%%22/><text fill=%22%2364748b%22 x=%2225%22 y=%2230%22 text-anchor=%22middle%22 font-size=%2210%22>N/A</text></svg>'">
                                                    </a>
                                                </td>
                                                <td>
                                                    <span data-timestamp="<%= entry.timestamp %>">
                                                        <%= new Date(entry.timestamp).toLocaleString() %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <% if (entry.extraData?.location?.city) { %>
                                                        <span class="badge badge-primary">
                                                            <i class="fas fa-map-marker-alt"></i>
                                                            <%= entry.extraData.location.city %>, <%= entry.extraData.location.country %>
                                                        </span>
                                                    <% } else { %>
                                                        <span class="badge badge-warning">Unknown</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <code class="code-tag secondary">
                                                        <%= entry.extraData?.network?.public_ip || 'N/A' %>
                                                    </code>
                                                </td>
                                                <td>
                                                    <div class="action-buttons">
                                                        <a href="/entry/<%= entry.id %>" class="btn btn-icon btn-secondary" title="View Details">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="fas fa-camera-retro"></i>
                                <h3>No Captures Yet</h3>
                                <p>Waiting for the first intruder detection...</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Recent Locations Map Preview -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-map-marked-alt text-secondary"></i>
                                Recent Locations
                            </h3>
                            <a href="/map" class="btn btn-sm btn-secondary">Full Map</a>
                        </div>

                        <div id="dashboard-map" class="map-preview-container"></div>

                        <% if (stats.countries.length > 0) { %>
                            <div class="badge-group mt-3">
                                <% stats.countries.slice(0, 5).forEach(function(country) { %>
                                    <span class="badge badge-success">
                                        <i class="fas fa-flag"></i>
                                        <%= country %>
                                    </span>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- System Info Summary -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-info-circle text-warning"></i>
                            System Information
                        </h3>
                    </div>

                    <div class="sys-info-grid">
                        <div class="sys-info-card">
                            <div class="sys-info-label">Server Status</div>
                            <div class="sys-info-value">
                                <span class="status-indicator online"></span>
                                <span>Online</span>
                            </div>
                        </div>
                        <div class="sys-info-card">
                            <div class="sys-info-label">API Endpoint</div>
                            <code class="code-tag primary">/api/upload</code>
                        </div>
                        <div class="sys-info-card">
                            <div class="sys-info-label">Authentication</div>
                            <span class="badge badge-success">
                                <i class="fas fa-lock"></i>
                                Enabled
                            </span>
                        </div>
                        <div class="sys-info-card">
                            <div class="sys-info-label">Rate Limiting</div>
                            <span class="badge badge-primary">
                                <i class="fas fa-tachometer-alt"></i>
                                Active
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Leaflet JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <%- include('partials/scripts') %>

    <script>
        // Initialize dashboard map
        const recentLocations = <%- JSON.stringify(stats.recentLocations || []) %>;

        const mapEl = document.getElementById('dashboard-map');
        if (mapEl) {
            const map = L.map('dashboard-map', {
                zoomControl: false,
                attributionControl: false
            }).setView([20, 0], 2);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            const markerIcon = L.divIcon({
                html: '<div class="map-preview-marker"></div>',
                className: 'custom-marker',
                iconSize: [12, 12],
                iconAnchor: [6, 6],
                popupAnchor: [0, -8]
            });

            if (Array.isArray(recentLocations)) {
                recentLocations.forEach(loc => {
                    if (loc.lat && loc.lng) {
                        L.marker([loc.lat, loc.lng], { icon: markerIcon })
                            .addTo(map)
                            .bindPopup(`<b>${loc.city || 'Unknown'}</b>`);
                    }
                });

                const bounds = recentLocations
                    .filter(l => l.lat && l.lng)
                    .map(l => [l.lat, l.lng]);

                if (bounds.length > 0) {
                    map.fitBounds(bounds, { padding: [20, 20], maxZoom: 5 });
                }
            }
        }
    </script>
</body>

</html>
