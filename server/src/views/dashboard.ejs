<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="SilentCamTrap - Intruder Detection Dashboard">
    <title>
        <%= title %> | SilentCamTrap
    </title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Leaflet CSS (for maps) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">

    <%- include('partials/styles') %>
</head>

<body>
    <div class="layout">
        <%- include('partials/sidebar') %>

            <!-- Main Content -->
            <main class="main-content">
                <%- include('partials/header-bar') %>

                    <div class="page-content">
                        <!-- Stats Grid -->
                        <div class="stats-grid">
                            <div class="card stat-card primary animate-fade-in" style="animation-delay: 0.1s">
                                <div class="card-header">
                                    <div>
                                        <div class="stat-value">
                                            <%= stats.total %>
                                        </div>
                                        <div class="stat-label">Total Captures</div>
                                    </div>
                                    <div class="card-icon">
                                        <i class="fas fa-camera"></i>
                                    </div>
                                </div>
                                <i class="fas fa-database stat-bg-icon"></i>
                            </div>

                            <div class="card stat-card success animate-fade-in" style="animation-delay: 0.2s">
                                <div class="card-header">
                                    <div>
                                        <div class="stat-value">
                                            <%= stats.today %>
                                        </div>
                                        <div class="stat-label">Today's Captures</div>
                                        <% if (stats.today> 0) { %>
                                            <span class="stat-change positive">
                                                <i class="fas fa-arrow-up"></i>
                                                Active
                                            </span>
                                            <% } %>
                                    </div>
                                    <div class="card-icon">
                                        <i class="fas fa-clock"></i>
                                    </div>
                                </div>
                                <i class="fas fa-bolt stat-bg-icon"></i>
                            </div>

                            <div class="card stat-card warning animate-fade-in" style="animation-delay: 0.3s">
                                <div class="card-header">
                                    <div>
                                        <div class="stat-value">
                                            <%= stats.thisWeek %>
                                        </div>
                                        <div class="stat-label">This Week</div>
                                    </div>
                                    <div class="card-icon">
                                        <i class="fas fa-calendar-week"></i>
                                    </div>
                                </div>
                                <i class="fas fa-chart-line stat-bg-icon"></i>
                            </div>

                            <div class="card stat-card danger animate-fade-in" style="animation-delay: 0.4s">
                                <div class="card-header">
                                    <div>
                                        <div class="stat-value">
                                            <%= stats.countries.length %>
                                        </div>
                                        <div class="stat-label">Countries Detected</div>
                                    </div>
                                    <div class="card-icon">
                                        <i class="fas fa-globe"></i>
                                    </div>
                                </div>
                                <i class="fas fa-map-marker-alt stat-bg-icon"></i>
                            </div>
                        </div>

                        <div class="grid-2">
                            <!-- Recent Captures -->
                            <div class="card animate-fade-in" style="animation-delay: 0.5s">
                                <div class="card-header">
                                    <h3 class="card-title">
                                        <i class="fas fa-history"
                                            style="margin-right: 0.5rem; color: var(--primary);"></i>
                                        Recent Captures
                                    </h3>
                                    <a href="/entries" class="btn btn-sm btn-secondary">View All</a>
                                </div>

                                <% if (recentEntries.length> 0) { %>
                                    <div class="table-container">
                                        <table class="data-table">
                                            <thead>
                                                <tr>
                                                    <th>Image</th>
                                                    <th>Time</th>
                                                    <th>Location</th>
                                                    <th>IP</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% recentEntries.slice(0, 5).forEach(function(entry) { %>
                                                    <tr>
                                                        <td>
                                                            <img src="/uploads/<%= entry.imagePath %>" alt="Capture"
                                                                class="thumbnail"
                                                                onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2250%22 height=%2250%22><rect fill=%22%23334155%22 width=%22100%%22 height=%22100%%22/><text fill=%22%2364748b%22 x=%2225%22 y=%2230%22 text-anchor=%22middle%22 font-size=%2210%22>N/A</text></svg>'">
                                                        </td>
                                                        <td>
                                                            <span data-timestamp="<%= entry.timestamp %>">
                                                                <%= new Date(entry.timestamp).toLocaleString() %>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <% if (entry.extraData?.location?.city) { %>
                                                                <span class="badge badge-primary">
                                                                    <i class="fas fa-map-marker-alt"></i>
                                                                    <%= entry.extraData.location.city %>, <%=
                                                                            entry.extraData.location.country %>
                                                                </span>
                                                                <% } else { %>
                                                                    <span class="badge badge-warning">Unknown</span>
                                                                    <% } %>
                                                        </td>
                                                        <td>
                                                            <code style="font-size: 0.8rem; color: var(--secondary);">
                                                <%= entry.extraData?.network?.public_ip || 'N/A' %>
                                            </code>
                                                        </td>
                                                        <td>
                                                            <div class="action-buttons">
                                                                <a href="/entry/<%= entry.id %>"
                                                                    class="btn btn-icon btn-secondary"
                                                                    title="View Details">
                                                                    <i class="fas fa-eye"></i>
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                    <% } else { %>
                                        <div class="empty-state">
                                            <i class="fas fa-camera-retro"></i>
                                            <h3>No Captures Yet</h3>
                                            <p>Waiting for the first intruder detection...</p>
                                        </div>
                                        <% } %>
                            </div>

                            <!-- Recent Locations Map Preview -->
                            <div class="card animate-fade-in" style="animation-delay: 0.6s">
                                <div class="card-header">
                                    <h3 class="card-title">
                                        <i class="fas fa-map-marked-alt"
                                            style="margin-right: 0.5rem; color: var(--secondary);"></i>
                                        Recent Locations
                                    </h3>
                                    <a href="/map" class="btn btn-sm btn-secondary">Full Map</a>
                                </div>

                                <div id="dashboard-map" style="height: 300px; border-radius: 12px; overflow: hidden;">
                                </div>

                                <% if (stats.countries.length> 0) { %>
                                    <div style="margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
                                        <% stats.countries.slice(0, 5).forEach(function(country) { %>
                                            <span class="badge badge-success">
                                                <i class="fas fa-flag"></i>
                                                <%= country %>
                                            </span>
                                            <% }); %>
                                    </div>
                                    <% } %>
                            </div>
                        </div>

                        <!-- Quick Stats -->
                        <div class="card animate-fade-in" style="animation-delay: 0.7s; margin-top: 1.5rem;">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fas fa-info-circle"
                                        style="margin-right: 0.5rem; color: var(--warning);"></i>
                                    System Information
                                </h3>
                            </div>

                            <div
                                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                                <div style="padding: 1rem; background: var(--bg-tertiary); border-radius: 10px;">
                                    <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.25rem;">
                                        Server Status</div>
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <span
                                            style="width: 8px; height: 8px; background: var(--success); border-radius: 50%; animation: pulse 2s infinite;"></span>
                                        <span style="font-weight: 500;">Online</span>
                                    </div>
                                </div>
                                <div style="padding: 1rem; background: var(--bg-tertiary); border-radius: 10px;">
                                    <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.25rem;">
                                        API Endpoint</div>
                                    <code style="font-size: 0.85rem; color: var(--primary-light);">/api/upload</code>
                                </div>
                                <div style="padding: 1rem; background: var(--bg-tertiary); border-radius: 10px;">
                                    <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.25rem;">
                                        Authentication</div>
                                    <span class="badge badge-success">
                                        <i class="fas fa-lock"></i>
                                        Enabled
                                    </span>
                                </div>
                                <div style="padding: 1rem; background: var(--bg-tertiary); border-radius: 10px;">
                                    <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.25rem;">
                                        Rate Limiting</div>
                                    <span class="badge badge-primary">
                                        <i class="fas fa-tachometer-alt"></i>
                                        Active
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
            </main>
    </div>

    <!-- Leaflet JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>

    <%- include('partials/scripts') %>

        <script>
            // Initialize dashboard map
            const recentLocations = <% - JSON.stringify(stats.recentLocations) %>;

            const map = L.map('dashboard-map', {
                zoomControl: false,
                attributionControl: false
            }).setView([20, 0], 2);

            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                maxZoom: 19
            }).addTo(map);

            // Custom marker icon
            const markerIcon = L.divIcon({
                html: '<div style="width: 12px; height: 12px; background: #6366f1; border: 2px solid white; border-radius: 50%; box-shadow: 0 0 10px rgba(99, 102, 241, 0.5);"></div>',
                className: 'custom-marker',
                iconSize: [12, 12]
            });

            // Add markers
            recentLocations.forEach(loc => {
                if (loc.lat && loc.lng) {
                    L.marker([loc.lat, loc.lng], { icon: markerIcon })
                        .addTo(map)
                        .bindPopup(`<b>${loc.city || 'Unknown'}</b>`);
                }
            });

            // Fit bounds if locations exist
            if (recentLocations.length > 0) {
                const bounds = recentLocations
                    .filter(l => l.lat && l.lng)
                    .map(l => [l.lat, l.lng]);

                if (bounds.length > 0) {
                    map.fitBounds(bounds, { padding: [20, 20], maxZoom: 5 });
                }
            }
        </script>
</body>

</html>