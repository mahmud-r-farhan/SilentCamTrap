<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body>
    <div class="layout">
        <%- include('partials/sidebar') %>

        <main class="main-content">
            <%- include('partials/header-bar') %>

            <div class="page-content">
                <div class="grid-2">
                    <!-- General Settings -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-cog text-primary"></i>
                                General Settings
                            </h3>
                        </div>

                        <div class="settings-list">
                            <div class="settings-item">
                                <div>
                                    <div class="font-medium">Authentication</div>
                                    <div class="text-xs text-muted">Require login to access dashboard</div>
                                </div>
                                <span class="badge <%= config.enableAuth ? 'badge-success' : 'badge-warning' %>">
                                    <i class="fas fa-<%= config.enableAuth ? 'check' : 'times' %>"></i>
                                    <%= config.enableAuth ? 'Enabled' : 'Disabled' %>
                                </span>
                            </div>

                            <div class="settings-item">
                                <div>
                                    <div class="font-medium">Rate Limiting</div>
                                    <div class="text-xs text-muted">Protect API from abuse</div>
                                </div>
                                <span class="badge <%= config.enableRateLimit ? 'badge-success' : 'badge-warning' %>">
                                    <i class="fas fa-<%= config.enableRateLimit ? 'check' : 'times' %>"></i>
                                    <%= config.enableRateLimit ? 'Enabled' : 'Disabled' %>
                                </span>
                            </div>

                            <div class="settings-item">
                                <div>
                                    <div class="font-medium">Max File Size</div>
                                    <div class="text-xs text-muted">Maximum upload size in MB</div>
                                </div>
                                <span class="badge badge-primary">
                                    <i class="fas fa-file"></i>
                                    <%= config.maxFileSizeMB %> MB
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- API Configuration -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-plug text-secondary"></i>
                                API Configuration
                            </h3>
                        </div>

                        <div class="settings-list">
                            <div class="settings-box">
                                <div class="font-medium mb-1">Upload Endpoint</div>
                                <code class="code-block primary">POST /api/upload</code>
                            </div>

                            <div class="settings-box">
                                <div class="font-medium mb-1">Health Check</div>
                                <code class="code-block success">GET /api/health</code>
                            </div>

                            <div class="settings-box">
                                <div class="font-medium mb-1">Headers Required</div>
                                <code class="code-block warning">X-API-Key: your-api-key
Content-Type: multipart/form-data</code>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Python Client Configuration -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fab fa-python python-icon"></i>
                            Python Client Configuration
                        </h3>
                        <button class="btn btn-secondary btn-sm" onclick="copyConfig()">
                            <i class="fas fa-copy"></i>
                            Copy Config
                        </button>
                    </div>

                    <pre id="python-config" class="json-viewer"><code class="text-secondary">{
  "api_url": "<span class="text-primary-light">http://your-server-url/api/upload</span>",
  "api_key": "<span class="text-warning">default-api-key</span>",
  "log_folder": "<span class="text-success">intruder_logs</span>",
  "webcam_index": <span class="text-warning">0</span>,
  "webcam_warmup_seconds": <span class="text-warning">0.8</span>,
  "webcam_frame_count": <span class="text-warning">10</span>,
  "connection_timeout": <span class="text-warning">30</span>,
  "send_retries": <span class="text-warning">3</span>,
  "send_retry_delay": <span class="text-warning">2.0</span>,
  "collection_timeout": <span class="text-warning">20</span>,
  "enable_shutdown": <span class="text-danger">false</span>,
  "enable_self_delete": <span class="text-danger">false</span>,
  "enable_browser_history": <span class="text-success">true</span>,
  "max_browser_history": <span class="text-warning">10</span>,
  "log_level": "<span class="text-secondary">INFO</span>"
}</code></pre>
                </div>

                <!-- Docker Quick Start -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fab fa-docker docker-icon"></i>
                            Docker Quick Start
                        </h3>
                    </div>

                    <div class="docker-grid">
                        <div class="docker-step">
                            <div class="docker-step-header">
                                <span class="step-badge">1</span>
                                Build Docker Image
                            </div>
                            <code class="code-block secondary">docker build -t silentcamtrap-server .</code>
                        </div>

                        <div class="docker-step">
                            <div class="docker-step-header">
                                <span class="step-badge">2</span>
                                Run Container
                            </div>
                            <code class="code-block secondary">docker run -d -p 3000:3000 -v ./data:/app/data silentcamtrap-server</code>
                        </div>

                        <div class="docker-step">
                            <div class="docker-step-header">
                                <span class="step-badge success">✓</span>
                                Access Dashboard
                            </div>
                            <code class="code-block primary">http://localhost:3000</code>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <%- include('partials/scripts') %>

    <script>
        function copyConfig() {
            const configText = JSON.stringify({
                "api_url": "http://localhost:3000/api/upload",
                "api_key": "default-api-key",
                "log_folder": "intruder_logs",
                "webcam_index": 0,
                "webcam_warmup_seconds": 0.8,
                "webcam_frame_count": 10,
                "connection_timeout": 30,
                "send_retries": 3,
                "send_retry_delay": 2.0,
                "collection_timeout": 20,
                "enable_shutdown": false,
                "enable_self_delete": false,
                "enable_browser_history": true,
                "max_browser_history": 10,
                "log_level": "INFO"
            }, null, 2);

            navigator.clipboard.writeText(configText).then(() => {
                showToast('Configuration copied to clipboard', 'success');
            }).catch(() => {
                const ta = document.createElement('textarea');
                ta.value = configText;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                ta.remove();
                showToast('Configuration copied to clipboard', 'success');
            });
        }
    </script>
</body>

</html>
