# Docker ignore file for SilentCamTrap Server

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Data directories (will be mounted as volumes)
data/

# Environment files
.env
.env.local
.env.*.local

# Git
.git/
.gitignore

# Documentation
*.md
docs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test files
__tests__/
*.test.js
*.spec.js
coverage/

# Logs
logs/
*.log

# Misc
.editorconfig
.prettierrc
.eslintrc*
